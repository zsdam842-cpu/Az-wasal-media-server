# المجال العام للسيرفر (يُعرَض في الرموز)
TURN_REALM=turn.wasal.example.com

# سرّ مشترك مع خادم الوسائط — يجب أن يطابق TURN_SECRET هناك.
# ولّده بـ: openssl rand -hex 32
TURN_SECRET=change-this-to-a-long-random-secret

# العنوان العام للسيرفر (مطلوب عندما يكون خلف NAT أو في حاوية)
TURN_EXTERNAL_IP=203.0.113.10

# المنافذ
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# TLS (اختياري لكنه مطلوب لشبكات تحجب المنافذ غير المشفّرة)
# TURN_TLS_CERT=/etc/letsencrypt/live/turn.wasal.example.com/fullchain.pem
# TURN_TLS_KEY=/etc/letsencrypt/live/turn.wasal.example.com/privkey.pem
