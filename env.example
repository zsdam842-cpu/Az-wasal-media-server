
PORT=3000
JWT_SECRET=change-this-in-production
CORS_ORIGIN=*
DATABASE_URL=postgresql://username:password@localhost:5432/wasal

# نداءات المكالمات: STUN دائمًا، وTURN عند ضبطه
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN مُدار (بديل جاهز بلا سيرفر): ضع رابط مزوّد TURN الذي يعيد iceServers.
# مثال (Metered Open Relay): https://<app>.metered.live/api/v1/turn/credentials?apiKey=XXX
# TURN_API_URL=

# TURN ببيانات اعتماد ثابتة من لوحة مزوّد مُدار (بلا مفتاح API):
# TURN_URLS=turn:global.relay.example.com:80,turn:global.relay.example.com:443
# TURN_USERNAME=
# TURN_CREDENTIAL=

# TURN بخادم خاص (coturn) — راجع coturn/README.md
# لا يُفعَّل إلا إذا كانت القيمتان أدناه مضبوطتين معًا، والسرّ هنا
# يجب أن يطابق TURN_SECRET في إعداد coturn.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_SECRET=
# TURN_TTL_SECONDS=3600
